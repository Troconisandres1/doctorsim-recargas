var pop_tramos_running = false;
var xhr ;
populateTramos = function(pais,oper,curAlt,chk,chk2,msisdn){
  if (pop_tramos_running) {
    return;
  } else {
    pop_tramos_running = true;
  }
  topup.setChk(0);
  topup.setChk2(0);
  topup.setMsisdnCh(0);
  var move = 70;
  if ($(window).width() > 1200) {
    move = 150;
  } else if ($(window).width() > 990) {
     move = 150;
  } else if ($(window).width() > 574) {
    move = 70;
  }
  if (!$('#nav-tabContent').is(':visible')) {
    $("html, body").animate({
        scrollTop: $('#showSelec').offset().top - move
    }, "slow");
  }
  $("#tr-form").hide(); // clean aviso no dispo
  $("#alert-no-tramo").hide(); // resto success aviso no dispo
  $("#no-tramo-form").show(); // reset form
  $("#lyca-llamaya-redirect").hide(); // hide Lyca redirect banner
  $("#tr-list").hide();
  $('#promo-block').hide();
  // $("#denom-tab").show();
  $("#tr-load").show();
  if(typeof(chk)!=='undefined' && chk){
    $('#modal_check .modal-content div').hide();
    $('#modal_check .modal-content .checking').show();
    $('#modal_check').modal({backdrop: 'static', keyboard: false});
    topup.setSelCountryId(pais);
    topup.setSelOperId(oper);
    topup.setChk(true);
  }
  if(typeof(chk2)!=='undefined' && chk2){
    topup.setChk2(chk2);
  }
  if(typeof(msisdn)!=='undefined' && msisdn && msisdn!=0 && msisdn!=''){
    topup.setMsisdnCh(msisdn);
  }
  var params = topup.getFetchParams();
  if(typeof(curAlt)!=='undefined' && curAlt!=''){
    params['curAlt'] = curAlt;
  }
  // $(".tab_cl_ck").addClass('disabled');

  // $(".nav-item.nav-link.tab_cl_ck").not(".active").fadeOut();

  params['cv']=1;

  // Preserve the original language for PayPal checkout - do not force to 'en'
  // The language should be passed as-is to PayPal so the checkout page displays in the correct language
  // Note: Template display may still use 'en' for non-es languages, but PayPal needs the actual language
  xhr = $.get(
    "/proc/fetch_topup.php",
    params,
    function(data){
      // $(".nav-item.nav-link.tab_cl_ck").not(".active").fadeIn();
      if (chk){
        $('#modal_check .modal-content .checking').hide();
        if (data.result=='OK'){
          $('#modal_check .modal-content .check-ok').show();
          location.href = data.url;
        }else{
          var oTableRequestvar = $('#topups_table_request').DataTable( );
          oTableRequestvar.ajax.reload();
          $('#modal_check .modal-content .check-ko').show();
          setTimeout(function() {
            $('#modal_check').modal('hide');
            $('#container-oper-recargas').hide();
            $("html, body").animate({ scrollTop: $('#table_topup_container').offset().top }, "slow");
          }, 4000);
        }
      }else{
        $("#tr-load").hide();
        var hasOpers = typeof(data)!=='undefined' && typeof(data.opers)!=='undefined' && Object.keys(data.opers).length;

        // Lyca ES redirect to Llamaya (Trello #9052)
        // Note: Lyca ES uses id_o=6931 in fetch_topup API (not database id_operador=18)
        var isLycaES = (params.id_o == 6931 && params.id_p == 34);

        // For PRO-gated products (pspp=1), the is_pro_user variable may not be set yet
        // because this CDN-cached response arrives before dsimHydration fires — a race
        // condition that is especially pronounced in native-app WebViews where the edge
        // cache is faster than the origin hydration round-trip. Wrap the render decision
        // in _applyFetchResult and defer it until hydration is ready when needed.
        var _applyFetchResult = function(isProUser) {
          var isProBlocked = (data && data.pspp == 1 && !isProUser);
        if (isLycaES) {
          // Lyca ES - show redirect message instead of prices or email form
          $("#tr-load").hide();
          $("#tr-list").hide();
          $("#tr-form").hide();
          $('#lyca-llamaya-redirect').show();
        } else if(hasOpers && !isProBlocked){
          // Ensure sticky_price section stays visible
          var $sticky_price = $('.sticky_price');
          if ($sticky_price.length > 0) {
            $sticky_price.show();
            $sticky_price.css('display', 'block');
            $('.topup-res-tramo-sel').show();
            $('.topup-res-tramo-sel').css('display', 'block');
            $('.topup-res-tramo-sel').css('visibility', 'visible');
          }
          
          topup.setFetch(data);
          $("#tr-list").show();
          if ($('#sms_notif:checkbox:checked').length > 0) {
            $(".sms_notif_text").slideDown();
          }
          $('#promo-block').show();
          topup.drawSections();
          
          // After drawSections, ensure sticky price is still visible
          setTimeout(function() {
            var $sticky = $('.sticky_price');
            var $box = $('.topup-res-tramo-sel');
            if ($sticky.length > 0) {
              $sticky.show().css({
                'display': 'block',
                'visibility': 'visible',
                'opacity': '1'
              });
            }
            if ($box.length > 0) {
              $box.show().css({
                'display': 'block',
                'visibility': 'visible',
                'opacity': '1',
                'background-color': '#fff',
                'border': '1px solid #197aa6'
              });
              
              // Set up MutationObserver to watch for style changes
              if (typeof MutationObserver !== 'undefined') {
                var observer = new MutationObserver(function(mutations) {
                  mutations.forEach(function(mutation) {
                    if (mutation.type === 'attributes' && (mutation.attributeName === 'style' || mutation.attributeName === 'class')) {
                      var display = $box.css('display');
                      var visibility = $box.css('visibility');
                      var opacity = $box.css('opacity');
                      if (display === 'none' || visibility === 'hidden' || opacity === '0' || $box.height() === 0) {
                        $box.css({
                          'display': 'block',
                          'visibility': 'visible',
                          'opacity': '1',
                          'background-color': '#fff',
                          'border': '1px solid #197aa6',
                          'min-height': '52px'
                        });
                      }
                    }
                  });
                });
                observer.observe($box[0], {
                  attributes: true,
                  attributeFilter: ['style', 'class']
                });
              }
            }
          }, 50);
          if (oper == false && (typeof(params.id_o)!=='undefined')) {
            oper = params.id_o;
          }
          var id_selected = $("div").find("[idoper='"+oper+"']").find($(".boton-precio-recarga .ribbon2")).parent().attr('top-id');
          var sel_recom_tram = 0;
          if (id_selected > 0) {
            sel_recom_tram = id_selected;
          }
          // Trello #9991: Pro carousel deep-link ?r=50 preselects last denomination.
          var preselectR = null;
          try {
            var rMatch = window.location.search.match(/[?&]r=([0-9]+(?:\.[0-9]+)?)/);
            if (rMatch) {
              preselectR = parseFloat(rMatch[1]);
            }
          } catch (ePre) {}
          if (preselectR !== null && data && data.opers && oper && data.opers[oper] && data.opers[oper].tr) {
            var preTr = data.opers[oper].tr;
            var preI;
            for (preI = 0; preI < preTr.length; preI++) {
              var preRv = parseFloat(String(preTr[preI].r || '0').replace(',', ''));
              if (!isNaN(preRv) && Math.abs(preRv - preselectR) < 0.011) {
                sel_recom_tram = preI;
                break;
              }
            }
          }
          topup.setSelSection(sel_recom_tram);
          if (preselectR !== null) {
            var $preBtn = $('#tr-list .boton-precio-recarga[top-id="' + sel_recom_tram + '"]');
            if ($preBtn.length) {
              $('#tr-list .boton-precio-recarga').removeClass('active');
              $preBtn.addClass('active');
            }
          }
          var obj = topup.getSelObject();
          
          var price = $('#tr-list .monto-cambio .precio-tramo .price_cost');
          var div_cost = $('#tr-list .monto-cambio .precio-tramo #div_sel_c');
          if (div_cost.length === 0) {
            div_cost = $('.monto-cambio .precio-tramo #div_sel_c');
          }
          if (div_cost.length === 0) {
            div_cost = $('#div_sel_c');
          }
          
          price.empty();
          if (obj!=false){
            var price_html = obj.p_a[topup.getCur()]+" <span class='hlp_price_cur_tot'>"+topup.getCur()+'</span>';
            price.html(price_html);
            
            // Also update sticky price section if it exists
            var sticky_price = $('.sticky_price .monto-cambio .precio-tramo .price_cost');
            if (sticky_price.length > 0) {
              sticky_price.html(price_html);
              
              // Ensure the container is visible
              $('.sticky_price').show();
              $('.topup-res-tramo-sel').show();
              $('.topup-res-tramo-sel').css({
                'display': 'block',
                'visibility': 'visible',
                'opacity': '1'
              });
            }
          }else{
            hideModif();
            topup.modifMsisdnInput('show');
            
            // Even if no object, keep sticky price visible
            $('.sticky_price').show();
            $('.topup-res-tramo-sel').show();
          }
          if (div_cost.length > 0) {
            div_cost.html(topup.getOthCur());
          }
          
          // Final check - ensure sticky price is visible
          setTimeout(function() {
            var $sticky = $('.sticky_price');
            var $box = $('.topup-res-tramo-sel');
            
            if (!$sticky.is(':visible') || !$box.is(':visible')) {
              $sticky.show().css({'display': 'block', 'visibility': 'visible'});
              $box.show().css({'display': 'block', 'visibility': 'visible', 'opacity': '1'});
            }
            
            // Force styles again with !important via attr style
            var currentBoxStyle = $box.attr('style') || '';
            $box.attr('style', currentBoxStyle + '; display: block !important; visibility: visible !important; opacity: 1 !important; background-color: #fff !important; border: 1px solid #197aa6 !important;');
            var currentStickyStyle = $sticky.attr('style') || '';
            $sticky.attr('style', currentStickyStyle + '; display: block !important; visibility: visible !important;');
          }, 100);
          
          // Additional check after a longer delay to catch any late DOM changes
          setTimeout(function() {
            var $sticky = $('.sticky_price');
            var $box = $('.topup-res-tramo-sel');
            if (!$sticky.is(':visible') || !$box.is(':visible') || $box.height() === 0) {
              $sticky.show().css({
                'display': 'block',
                'visibility': 'visible'
              });
              $box.show().css({
                'display': 'block',
                'visibility': 'visible',
                'opacity': '1',
                'background-color': '#fff',
                'border': '1px solid #197aa6',
                'min-height': '52px'
              });
            }
          }, 500);
        }else{
          $('#tr-form').show();
          $("#container-special-service-input-form").hide();
          $("#container-input-svs-toggle-btn-parent").hide();
          
          // Keep sticky price visible even in this case
          $('.sticky_price').show();
          $('.topup-res-tramo-sel').show();
        }
        }; // end _applyFetchResult

        if (data && data.pspp == 1 && typeof dsimHydration !== 'undefined' && !dsimHydration.getState()) {
          // PRO-gated product but hydration not yet complete — defer render until we
          // know the user's PRO status, avoiding the race condition on native WebViews
          // where the CDN-cached AJAX response arrives before the hydration endpoint.
          dsimHydration.onReady(function(state) {
            _applyFetchResult(state && state.auth && state.auth.is_pro ? true : false);
          });
        } else {
          // Non-PRO product OR hydration already done — resolve immediately
          var _proUser = (typeof dsimHydration !== 'undefined' && dsimHydration.getState())
            ? dsimHydration.isPro()
            : is_pro_user;
          _applyFetchResult(_proUser);
        }

        delete params['cv'];
        $.get(
          "/proc/fetch_topup.php",
          params,
          function(data){
            // Fresh data sync: the non-cv call hits origin and populates the session.
            // If Cloudflare served stale data for cv=1, the browser state and session
            // would be out of sync, causing "wrong token" errors at checkout.
            // We update the browser state here to match the fresh session data.
            var hasOpers = typeof(data) !== 'undefined' && typeof(data.opers) !== 'undefined'
                           && Object.keys(data.opers).length;

            if (hasOpers && topup.checkFetch()) {
              var oldOper = topup.fetch.opers[topup.selOId];
              var newOper = data.opers[topup.selOId];
              var currentInx = topup.getSelSection();
              var dataChanged = false;

              // Quick comparison: tier count + send/receive/tool values
              try {
                if (!oldOper || !newOper || oldOper.tr.length !== newOper.tr.length) {
                  dataChanged = true;
                } else {
                  for (var j = 0; j < oldOper.tr.length; j++) {
                    if (oldOper.tr[j].s !== newOper.tr[j].s
                        || oldOper.tr[j].r !== newOper.tr[j].r
                        || oldOper.tr[j].t !== newOper.tr[j].t) {
                      dataChanged = true;
                      break;
                    }
                  }
                }
              } catch(e) {
                dataChanged = true;
              }

              // Always update internal data to match the session
              topup.setFetch(data);

              if (dataChanged) {
                // Re-render pricing tier buttons
                topup.drawSections();

                // Re-apply user's selection (or fall back to recommended/first)
                var newTr = data.opers[topup.selOId] ? data.opers[topup.selOId].tr : null;
                if (newTr && newTr[currentInx]) {
                  var selBtn = $(topup.getTabName() + ' .boton-precio-recarga[top-id="' + currentInx + '"]');
                  if (selBtn.length > 0) {
                    selBtn.addClass('active');
                    topup.setSelSection(currentInx);
                  }
                } else {
                  // Selected index no longer exists - pick recommended or first
                  var recBtn = $(topup.getTabName() + ' .boton-precio-recarga .ribbon2').parent();
                  if (recBtn.length > 0) {
                    recBtn.addClass('active');
                    topup.setSelSection(recBtn.attr('top-id'));
                  } else {
                    var firstBtn = $(topup.getTabName() + ' .boton-precio-recarga').first();
                    if (firstBtn.length > 0) {
                      firstBtn.addClass('active');
                      topup.setSelSection(firstBtn.attr('top-id'));
                    }
                  }
                }

                // Update checkout params and all price displays
                drawSelection();
              } else {
                // Data unchanged - silently refresh checkout params from fresh data
                topup.getSelObject();
              }
            }

            // Keep existing sticky price visibility (runs regardless)
            setTimeout(function() {
              var $sticky = $('.sticky_price');
              var $box = $('.topup-res-tramo-sel');
              if ($sticky.length > 0 && $box.length > 0) {
                $sticky.show().css({
                  'display': 'block',
                  'visibility': 'visible'
                });
                $box.show().css({
                  'display': 'block',
                  'visibility': 'visible',
                  'opacity': '1',
                  'background-color': '#fff',
                  'border': '1px solid #197aa6'
                });
              }
            }, 50);
          },
          "json"
        );
      }

      if (pop_tramos_running) {
        pop_tramos_running = false;
      }
      // var uri_h = topup.getUriHash();
      // console.log(uri_h);
      // window.location.hash = "#internet";
    },
    "json"
  );
}
