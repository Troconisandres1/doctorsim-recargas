// Custom sorting function
function customSort(a, b) {
  const specialCategories = ["Tarjeta Regalo", "Giftcard"];
  if (specialCategories.includes(a) && !specialCategories.includes(b)) {
    return -1;
  }
  if (!specialCategories.includes(a) && specialCategories.includes(b)) {
    return 1;
  }
  return a.localeCompare(b);
}

dsimTopupObj.prototype.updateOpers = function(id, opers, mobile, check, others, opers_others) {
  if (arguments.length === 5) {
    opers_others = others;
    others = check;
    check = false;
  } else if (arguments.length === 4) {
    opers_others = {};
    others = check;
    check = false;
  }

  check = !!check;
  others = !!others;

  var $mainList = $('#oper-recargas-list');
  var $othersList = $('#oper-recargas-list-others');
  var $container = $('#container-oper-recargas');

  // Save the filter box and search results before emptying (for giftcards)
  var $filterBox = $('#filter_gc_box').length ? $('#filter_gc_box').detach() : null;
  var $searchResults = $('#searchResults').length ? $('#searchResults').detach() : null;

  if ($othersList.length) {
    $othersList.empty();
  }

  if ($mainList.length) {
    $mainList.addClass('ds-topup-grid topup-rel-list').removeClass('row').removeClass('mt-md-4');
  }

 if ($container.length) {
    $container.show();
  }

  if (typeof isGiftcardPage !== 'undefined' && isGiftcardPage) {
    $('#title_others, #title_old, #title_others2').hide();
    $('#oper-recargas-list-others').addClass('ds-giftcard-list');
  }

  var mobileFlag = (typeof mobile === 'undefined') ? '' : mobile;

  var noSvMsg = (typeof global_lang !== 'undefined' && global_lang === 'es')
    ? 'No hay servicios adicionales en estos momentos para este pais.'
    : 'There are no additional services at the moment for this country.';

  var defaultAnalytics = (typeof isGiftcardPage !== 'undefined' && isGiftcardPage && typeof analyticsGiftEvent !== 'undefined')
    ? analyticsGiftEvent
    : (typeof analyticsTopupEvent !== 'undefined' ? analyticsTopupEvent : 'topup-card-action');

  function jsStringEscape(value) {
    return String(value == null ? '' : value).replace(/\\/g, '\\\\').replace(/'/g, "\\'");
  }

  function resolveDisplayName(oper) {
    var name = '';
    if (oper && oper.operador_custom_name && $.trim(oper.operador_custom_name) !== '') {
      name = $.trim(oper.operador_custom_name);
    } else if (oper && oper.operador) {
      name = $.trim(oper.operador);
    } else if (oper && oper.name_oper_display) {
      name = $.trim(oper.name_oper_display);
    }

    var country = '';
    if (oper && oper.pais && $.trim(oper.pais) !== '') {
      country = $.trim(oper.pais);
    } else if (oper && oper.name_pais_display && $.trim(oper.name_pais_display) !== '') {
      country = $.trim(oper.name_pais_display);
    } else if (oper && oper.country && $.trim(oper.country) !== '') {
      country = $.trim(oper.country);
    }

    if (country && name) {
      var normalizedCountry = country.toLowerCase();
      var normalizedName = name.toLowerCase();
      if (normalizedName.indexOf(normalizedCountry) === -1) {
        return country + ' - ' + name;
      }
    }

    return name || country;
  }

  function resolveImageUrl(oper) {
    if (oper && oper.img_cdn_url && $.trim(oper.img_cdn_url) !== '') {
      return oper.img_cdn_url;
    }
    if (oper && oper.url_imagen && $.trim(oper.url_imagen) !== '') {
      return 'https://www.doctorsim.com/img/oper/' + oper.url_imagen;
    }
    return '';
  }

  function buildCard(oper, options) {
    var settings = $.extend({ useCheck: false }, options || {});
    var displayName = resolveDisplayName(oper);

    var imgUrl = resolveImageUrl(oper);
    var hrefValue = '#';
    var gotoUrl = '';
    if (settings.useCheck) {
      hrefValue = "javascript:checkTool('" + jsStringEscape(oper.id_operador) + "','" + jsStringEscape(oper.id_pais) + "','" + jsStringEscape(mobileFlag) + "')";
    } else if (oper && oper.href) {
      hrefValue = oper.href;
      gotoUrl = oper.href;
    }

    var $card = $('<a>', {
      'class': 'ds-topup-card loading',
      'data-operator': displayName,
      href: hrefValue,
      'data-analytics': settings.analytics || defaultAnalytics
    }).attr('notranslate', '');
    
    if (gotoUrl) {
      $card.attr('data-goto-url', gotoUrl);
    }

    if (imgUrl) {
      $('<img>', {
        src: imgUrl,
        alt: displayName,
        loading: 'lazy'
      }).appendTo($card);
    }

    if (displayName) {
      $('<span>', {
        'class': 'ds-topup-card__name',
        text: displayName
      }).appendTo($card);
    }

    return $card;
  }

  if ($mainList.length) {
    $mainList.empty();
    if (Array.isArray(opers) && opers.length) {
      $.each(opers, function(_, oper) {
        $mainList.append(buildCard(oper, { useCheck: check }));
      });
    }
  }

  var isGiftcardView = (typeof isGiftcardPage !== 'undefined' && isGiftcardPage);

  if (others && $othersList.length) {
    $('#title_others').show();
    $('#title_others2').show();
    $('#title_old').hide();
    $othersList.show();

    var categories = Object.keys(opers_others || {}).sort(customSort);
    if (!categories.length) {
      $othersList.append(
        $('<div>', { 'class': 'col-12' }).append(
          $('<div>', { 'class': 'alert alert-warning', role: 'alert' }).text(noSvMsg)
        )
      );
      $('#filter_gc_box').hide();
    } else {
      var totalItems = 0;
      var hideGiftcardCrossSell = (
        typeof this.temp !== 'undefined' &&
        this.temp === 'po' &&
        (typeof isGiftcardPage === 'undefined' || !isGiftcardPage)
      );
      $.each(categories, function(_, category) {
        var items = opers_others[category] || [];
        if (!Array.isArray(items) || !items.length) {
          return;
        }

        var slug = category.toString().trim().toLowerCase().replace(/\s+/g, '-');
        var isGiftcardCategory = (category === 'Tarjeta Regalo' || category === 'Giftcard');
        if (hideGiftcardCrossSell && isGiftcardCategory) {
          return;
        }
        
        var $category = $('<div>', {
          id: 'oper-recargas-list-others-' + slug,
          'class': 'col-12' + (isGiftcardCategory ? ' ds-giftcard-section' : '')
        });

        var $sectionTitle = $('<div>', { 
          'class': 'ds-section-title' + (isGiftcardCategory ? ' ds-section-title--with-search' : '')
        }).append(
          $('<h3>').text(category)
        );
        
        $category.append($sectionTitle);

        // Re-add the filter box and search results for giftcard category
        if (isGiftcardCategory && $filterBox) {
          $filterBox.show();
          $sectionTitle.append($filterBox);
        }
        if (isGiftcardCategory && $searchResults) {
          $category.append($searchResults);
        }

        var sortedItems = items.slice().sort(function(a, b) {
          var langKeyA = ((global_lang === 'es') ? a.txt_es : a.txt_en) || '';
          var langKeyB = ((global_lang === 'es') ? b.txt_es : b.txt_en) || '';
          var primary = langKeyA.localeCompare(langKeyB);
          if (primary !== 0) {
            return primary;
          }
          var cleanA = (a.clean_o || '').toString();
          var cleanB = (b.clean_o || '').toString();
          return cleanA.localeCompare(cleanB);
        });

        if (isGiftcardCategory) {

          var grouped = {};
          var subcategoryOrder = [];

          $.each(sortedItems, function(_, oper) {
            var subKey = ((global_lang === 'es') ? oper.txt_es : oper.txt_en) || '';
            if (!grouped[subKey]) {
              grouped[subKey] = [];
              subcategoryOrder.push(subKey);
            }
            grouped[subKey].push(oper);
          });

          $.each(subcategoryOrder, function(_, subcategoryName) {
            var $subcategory = $('<div>', { 'class': 'subcategory' });
            $subcategory.append(
              $('<span>', { 'class': 'hX2 text-bluegrey' }).text(subcategoryName).css({
                display: 'block',
                fontSize: '1.1rem',
                fontWeight: 700
              })
            );

            var $grid = $('<div>', { 'class': 'ds-topup-grid' });
            $.each(grouped[subcategoryName], function(_, oper) {
              $grid.append(buildCard(oper, { useCheck: check }));
              totalItems++;
            });
            $subcategory.append($grid);
            $category.append($subcategory);
          });
        } else {
          var $grid = $('<div>', { 'class': 'ds-topup-grid' });
          $.each(sortedItems, function(_, oper) {
            $grid.append(buildCard(oper, { useCheck: check }));
            totalItems++;
          });
          $category.append($grid);
        }

        $othersList.append($category);
      });

      if (totalItems === 0) {
        $othersList.append(
          $('<div>', { 'class': 'col-12' }).append(
            $('<div>', { 'class': 'alert alert-warning', role: 'alert' }).text(noSvMsg)
          )
        );
        $('#filter_gc_box').hide();
      } else {
        if ($('#filter_gc_box').length) {
          if (isGiftcardView) {
            $('#filter_gc_box').fadeIn();
          } else if (totalItems > 4) {
            $('#filter_gc_box').fadeIn();
          } else {
            $('#filter_gc_box').hide();
          }
        }
      }
    }
  } else {
    $('#title_others').hide();
    $('#title_others2').hide();
    $('#title_old').show();
    if (typeof isGiftcardPage !== 'undefined' && isGiftcardPage) {
      $('#title_old').hide();
    }
    if ($('#filter_gc_box').length) {
      if (isGiftcardView) {
        $('#filter_gc_box').show();
      } else {
        $('#filter_gc_box').hide();
      }
    }

    if ($othersList.length && typeof isGiftcardPage !== 'undefined' && isGiftcardPage) {
      $othersList.append(
        $('<div>', { 'class': 'col-12' }).append(
          $('<div>', { 'class': 'alert alert-warning', role: 'alert' }).text(noSvMsg)
        )
      );
    }
  }

  this.selCId = id;
}

