/**
 * Email domain blacklist validation helper
 *
 * ES5-compatible. No arrow functions, no let/const, no template literals.
 * Provides dsimCheckEmailDomain() for use with jQuery Validate custom methods.
 *
 * Usage:
 *   dsimCheckEmailDomain(value)         → true if domain is OK, false if blacklisted
 *   dsimSuggestEmailDomain(value)       → corrected email string or null
 */
(function (window) {

    /**
     * Map of blacklisted domains to their correct counterparts.
     * Must stay in sync with EmailDomainBlacklist.class.php.
     */
    var DOMAIN_BLACKLIST = {
        // Gmail
        'gnail.com':    'gmail.com',
        'gamil.com':    'gmail.com',
        'gmail.con':    'gmail.com',
        'gmail.co':     'gmail.com',
