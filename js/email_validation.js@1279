            '  white-space: nowrap;',
            '  overflow: hidden;',
            '  text-overflow: ellipsis;',
            '}',
            '#email-domain-hint .dsim-suggestion-link,',
            '.dsim-email-suggestion .dsim-suggestion-link {',
            '  color: #197aa6;',
            '  font-weight: 600;',
            '  text-decoration: none;',
            '  border-bottom: 1px solid rgba(25, 122, 166, 0.4);',
            '  cursor: pointer;',
            '  transition: background 0.15s, color 0.15s;',
            '}',
            '#email-domain-hint .dsim-suggestion-link:hover,',
            '.dsim-email-suggestion .dsim-suggestion-link:hover {',
            '  background: #197aa6;',
            '  color: #fff;',
            '  border-bottom-color: transparent;',
            '  border-radius: 2px;',
            '  padding: 0 3px;',
            '}'
        ].join('\n');
        document.head.appendChild(style);
    }

}(window));
