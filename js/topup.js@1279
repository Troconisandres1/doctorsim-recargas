dsSlideUp = function(elem){ elem.slideUp('fast', function(){ elem.css('overflow','visible') }); }
dsSlideDown = function(elem){ elem.slideDown('fast', function(){ elem.css('overflow','visible') }); }
clearTopupLoaderTimeout = function() {
  if (topupLoaderTimeoutId !== null) {
    clearTimeout(topupLoaderTimeoutId);
    topupLoaderTimeoutId = null;
  }
};
cleanupTopupModalBackdrops = function() {
  $('body').removeClass('modal-open');
  $('.modal-backdrop').remove();
};
hideTopupOperatorLoader = function(callback) {
  clearTopupLoaderTimeout();
  var $loader = $('#loader_check');
  var done = false;
  var finish = function() {
    if (done) {
      return;
    }
    done = true;
    cleanupTopupModalBackdrops();
    if (callback) {
      callback();
    }
  };

  if (!$loader.length) {
    finish();
    return;
  }

  if (!$loader.hasClass('in') && $loader.css('display') === 'none') {
    finish();
    return;
  }

  $loader.one('hidden.bs.modal', function() {
    finish();
  });

  setTimeout(function() {
    if (!done) {
      $loader.hide();
      finish();
    }
  }, 500);

  $loader.modal('hide');
};
