        // Protonmail
        'protonmail.con': 'protonmail.com',
        'protonmial.com': 'protonmail.com',
        // MSN
        'msn.con':      'msn.com',
        // Yandex
        'yandex.con':   'yandex.com',
        'yandex.cmo':   'yandex.com'
    };

    /**
     * Extract domain from an email address.
     * @param  {string} email
     * @return {string|null}
     */
    function extractDomain(email) {
        var parts = email.split('@');
        if (parts.length !== 2 || parts[1] === '') {
            return null;
        }
        return parts[1].toLowerCase();
    }

    /**
     * Check whether the email domain is NOT blacklisted.
     * Returns true if the email is acceptable (domain not in blacklist).
     * Returns false if the domain is blacklisted (should be rejected).
     *
     * @param  {string} email
     * @return {boolean}
     */
    function dsimCheckEmailDomain(email) {
        var domain = extractDomain(email);
        if (domain === null) {
            return true;
        }
        return !DOMAIN_BLACKLIST.hasOwnProperty(domain);
    }

    /**
     * Return a suggestion for the correct email when the domain is blacklisted.
     * Returns null if the domain is not blacklisted.
     *
     * @param  {string} email
     * @return {string|null}
     */
    function dsimSuggestEmailDomain(email) {
        var domain = extractDomain(email);
        if (domain === null || !DOMAIN_BLACKLIST.hasOwnProperty(domain)) {
            return null;
        }
        var parts = email.split('@');
        return parts[0] + '@' + DOMAIN_BLACKLIST[domain];
    }

    window.dsimCheckEmailDomain = dsimCheckEmailDomain;
    window.dsimSuggestEmailDomain = dsimSuggestEmailDomain;

    var styleId = 'dsim-email-hint-styles';
    if (!document.getElementById(styleId)) {
        var style = document.createElement('style');
        style.id = styleId;
        style.type = 'text/css';
        style.innerHTML = [
